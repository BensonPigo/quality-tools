{
  "setup": [
    [
      "npm",
      "ci"
    ]
  ],
  "scenarios": [
    {
      "name": "沒改東西：CRAP 通過",
      "run": [
        "crap",
        "--base",
        "main"
      ],
      "exit": 0,
      "contains": [
        "PASS：這次沒有改到任何函式"
      ]
    },
    {
      "name": "沒改東西：變異測試通過",
      "run": [
        "mutation",
        "--base",
        "main"
      ],
      "exit": 0,
      "contains": [
        "PASS：這次沒有改到正式程式碼"
      ]
    },
    {
      "name": "改到沒有測試的舊函式 weight：CRAP 沒過，要補測試",
      "edits": [
        {
          "file": "src/shipping/fee.ts",
          "old": "return 50;",
          "new": "return 55;"
        }
      ],
      "run": [
        "crap",
        "--base",
        "main"
      ],
      "exit": 1,
      "contains": [
        "覆蓋率要到 35%",
        "FAIL：1 個函式"
      ]
    },
    {
      "name": "只改函式外面的註解：不算改到函式",
      "edits": [
        {
          "file": "src/shipping/fee.ts",
          "old": "// 依金額和地區算運費。",
          "new": "// 依金額和地區計算運費。"
        }
      ],
      "run": [
        "crap",
        "--base",
        "main"
      ],
      "exit": 0,
      "contains": [
        "PASS：這次沒有改到任何函式"
      ]
    },
    {
      "name": "fee 的免運門檻改成 999：只測了 1000 元，邊界的改壞版本沒抓到，抓錯率門檻 100 時沒過",
      "edits": [
        {
          "file": "src/shipping/fee.ts",
          "old": "if (total >= 1000) {",
          "new": "if (total >= 999) {"
        },
        {
          "file": ".quality.json",
          "old": "\"kill_rate_threshold\": 80",
          "new": "\"kill_rate_threshold\": 100"
        }
      ],
      "run": [
        "mutation",
        "--base",
        "main"
      ],
      "exit": 1,
      "contains": [
        "沒抓到",
        "FAIL："
      ]
    },
    {
      "name": "測試失敗：test 回傳 1",
      "edits": [
        {
          "file": "src/checkout.test.ts",
          "old": "expect(fee(1000, \"本島\")).toBe(0)",
          "new": "expect(fee(1000, \"本島\")).toBe(5)"
        }
      ],
      "run": [
        "test"
      ],
      "exit": 1
    },
    {
      "name": "測試失敗：crap 回傳 2",
      "edits": [
        {
          "file": "src/checkout.test.ts",
          "old": "expect(fee(1000, \"本島\")).toBe(0)",
          "new": "expect(fee(1000, \"本島\")).toBe(5)"
        }
      ],
      "run": [
        "crap",
        "--base",
        "main"
      ],
      "exit": 2
    },
    {
      "name": "v1 格式的設定檔：結束碼 2，提示執行 migrate",
      "edits": [
        {
          "file": ".quality.json",
          "content": "{\n  \"language\": \"js\",\n  \"base\": \"origin/main\",\n  \"crap_threshold\": 12,\n  \"efficacy_threshold\": 80,\n  \"mutant_coverage_threshold\": 0,\n  \"exclude\": [\"tools/\", \"vendor/\", \"node_modules/\"]\n}\n"
        }
      ],
      "run": [
        "crap",
        "--base",
        "main"
      ],
      "exit": 2,
      "contains": [
        "migrate"
      ]
    },
    {
      "name": "設定檔有打錯字的鍵：結束碼 2，不會默默變成預設值",
      "edits": [
        {
          "file": ".quality.json",
          "old": "\"version\": 2,",
          "new": "\"version\": 2,\n  \"gate\": [\"test\"],"
        }
      ],
      "run": [
        "crap",
        "--base",
        "main"
      ],
      "exit": 2,
      "contains": [
        "不認得的鍵：gate"
      ]
    },
    {
      "name": "--json 輸出符合格式：crap 和 mutation 各一份",
      "edits": [
        {
          "file": "src/shipping/fee.ts",
          "old": "if (total >= 1000) {",
          "new": "if (total >= 999) {"
        },
        {
          "file": ".quality.json",
          "old": "\"kill_rate_threshold\": 80",
          "new": "\"kill_rate_threshold\": 0"
        }
      ],
      "steps": [
        {
          "run": [
            "crap",
            "--base",
            "main",
            "--json",
            "out-crap.json"
          ],
          "exit": 0,
          "json": "out-crap.json"
        },
        {
          "run": [
            "mutation",
            "--base",
            "main",
            "--json",
            "out-mut.json"
          ],
          "exit": 0,
          "json": "out-mut.json"
        }
      ]
    }
  ]
}
