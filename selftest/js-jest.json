{
  "setup": [
    [
      "npm",
      "ci"
    ]
  ],
  "scenarios": [
    {
      "name": "沒改東西：CRAP 通過",
      "run": [
        "crap",
        "--base",
        "main"
      ],
      "exit": 0,
      "contains": [
        "PASS：這次沒有改到任何函式"
      ]
    },
    {
      "name": "沒改東西：變異測試通過",
      "run": [
        "mutation",
        "--base",
        "main"
      ],
      "exit": 0,
      "contains": [
        "PASS：這次沒有改到正式程式碼"
      ]
    },
    {
      "name": "改到沒有測試的舊函式 weight：CRAP 剛好等於門檻，通過",
      "edits": [
        {
          "file": "lib/shipping/fee.js",
          "old": "return 100;",
          "new": "return 110;"
        }
      ],
      "run": [
        "crap",
        "--base",
        "main"
      ],
      "exit": 0,
      "contains": [
        "PASS：所有函式的 CRAP 都在門檻 12 以內"
      ]
    },
    {
      "name": "只改函式外面的註解：不算改到函式",
      "edits": [
        {
          "file": "lib/shipping/fee.js",
          "old": "// 依金額和地區算運費。",
          "new": "// 依金額和地區計算運費。"
        }
      ],
      "run": [
        "crap",
        "--base",
        "main"
      ],
      "exit": 0,
      "contains": [
        "PASS：這次沒有改到任何函式"
      ]
    },
    {
      "name": "fee 的免運門檻改成 999：只測了 1000 元，邊界的突變體存活，效能門檻 100 時沒過",
      "edits": [
        {
          "file": "lib/shipping/fee.js",
          "old": "if (total >= 1000) {",
          "new": "if (total >= 999) {"
        },
        {
          "file": ".quality.json",
          "old": "\"efficacy_threshold\": 80",
          "new": "\"efficacy_threshold\": 100"
        }
      ],
      "run": [
        "mutation",
        "--base",
        "main"
      ],
      "exit": 1,
      "contains": [
        "LIVED",
        "FAIL："
      ]
    },
    {
      "name": "測試失敗：test 回傳 1",
      "edits": [
        {
          "file": "lib/shipping/fee.test.js",
          "old": "expect(fee(1000, \"本島\")).toBe(0)",
          "new": "expect(fee(1000, \"本島\")).toBe(5)"
        }
      ],
      "run": [
        "test"
      ],
      "exit": 1
    },
    {
      "name": "測試失敗：crap 回傳 2",
      "edits": [
        {
          "file": "lib/shipping/fee.test.js",
          "old": "expect(fee(1000, \"本島\")).toBe(0)",
          "new": "expect(fee(1000, \"本島\")).toBe(5)"
        }
      ],
      "run": [
        "crap",
        "--base",
        "main"
      ],
      "exit": 2
    }
  ]
}
